{
  "name": "pdf-editor",
  "version": "0.8.2",
  "private": true,
  "description": "Integrated PDF editing beta for Obsidian with mixed-object selection, automatic saving and recovery.",
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "holtsdav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holtsdav/PDF-Editor.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production && node scripts/validate-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.mjs",
    "format": "prettier --write src tests scripts *.mjs styles.css *.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts *.mjs styles.css *.json .prettierrc.json",
    "test": "node --test tests/*.test.ts",
    "test:stress": "node --test tests/stress/*.test.ts",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "install:dev": "node scripts/install-dev.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "validate": "node scripts/validate-plugin.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "perfect-freehand": "1.2.3"
  }
}
